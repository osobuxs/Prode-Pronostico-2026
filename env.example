# ──────────────────────────────────────────────────────────────
# Copiá este archivo a .env.local y completá los valores.
#   cp env.example .env.local
# NUNCA commitees .env.local (ya está en .gitignore).
# ──────────────────────────────────────────────────────────────

# Supabase ─ las sacás de tu proyecto en https://supabase.com
#   Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Esta es SECRETA: solo se usa en scripts/cron del servidor (NUNCA en el front).
#   Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# API de resultados reales ─ football-data.org (free tier).
#   Registrate gratis en https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=tu-api-key

# Código de la competición en football-data.org (Mundial = WC).
FOOTBALL_DATA_COMPETITION=WC
